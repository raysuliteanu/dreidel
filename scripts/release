#!/usr/bin/env bash
# Release script for dreidel.
#
# Usage: scripts/release [-n|--dry-run] [-y|--yes] [patch|minor|major]
#
# Regenerates CHANGELOG.md via git-cliff, commits it, then runs cargo-release
# to bump the version, commit, and tag, then syncs jj and pushes the bookmark
# and tag to origin. The tag push triggers the cargo-dist CI workflow, which
# builds release artifacts and creates the GitHub release automatically.
#
# Dry-run mode (-n / --dry-run):
#   - git-cliff/jj commit steps are echoed but not run
#   - cargo release runs without --execute (its own dry-run)
#   - jj/git push commands are echoed with the real resolved values but not run
#
# Confirmation:
#   A real release asks once, before changing anything (cargo release itself is
#   run with --no-confirm). Pass -y / --yes to skip the question, e.g. when
#   running without a terminal.

set -euo pipefail

DRY_RUN=false
ASSUME_YES=false
LEVEL="patch"

usage() {
    printf 'usage: scripts/release [-n|--dry-run] [-y|--yes] [patch|minor|major]\n' >&2
}

for arg in "$@"; do
    case "$arg" in
        -n | --dry-run) DRY_RUN=true ;;
        -y | --yes) ASSUME_YES=true ;;
        patch | minor | major) LEVEL="$arg" ;;
        *)
            printf 'error: unknown argument "%s"\n' "$arg" >&2
            usage
            exit 1
            ;;
    esac
done

if ! command -v cargo-release >/dev/null 2>&1; then
    printf 'error: cargo-release not found; run: cargo install cargo-release --locked\n' >&2
    exit 1
fi

if ! command -v git-cliff >/dev/null 2>&1; then
    printf 'error: git-cliff not found; run: brew install git-cliff\n' >&2
    exit 1
fi

if ! command -v jj >/dev/null 2>&1; then
    printf 'error: jj not installed or not on PATH\n' >&2
    exit 1
fi

if ! jj root >/dev/null 2>&1; then
    printf 'error: must be run inside a jj repository\n' >&2
    exit 1
fi

# Compute what the next version will be so dry-run echo lines show real values.
current_version=$(grep '^version = ' Cargo.toml | head -1 | cut -d'"' -f2)
IFS='.' read -r ver_major ver_minor ver_patch <<< "$current_version"
case "$LEVEL" in
    major) next_version="$((ver_major + 1)).0.0" ;;
    minor) next_version="${ver_major}.$((ver_minor + 1)).0" ;;
    patch) next_version="${ver_major}.${ver_minor}.$((ver_patch + 1))" ;;
esac
TAG="v${next_version}"

if "$DRY_RUN"; then
    printf '[dry run] %s -> %s\n\n' "$current_version" "$next_version"
    printf '[dry run] would run:\n'
    printf '  git-cliff --tag %s --output CHANGELOG.md\n' "$TAG"
    printf '  jj commit -m "chore: update changelog for %s"\n' "$TAG"
    printf '\n'
    # cargo release has its own dry-run mode (omit --execute); let it run for real.
    # It always exits non-zero in dry-run ("aborting upload due to dry run"),
    # so suppress the exit code — the output is what matters here.
    cargo release "$LEVEL" || true
    printf '\n[dry run] would run:\n'
    printf '  jj git fetch\n'
    printf '  jj bookmark set main -r @-\n'
    printf '  jj git push --bookmark main\n'
    printf '  git push origin %s\n' "$TAG"
    printf '  # cargo-dist CI workflow triggers on the tag push and creates the GitHub release\n'
else
    if ! "$ASSUME_YES"; then
        if [[ ! -t 0 ]]; then
            printf 'error: no terminal to confirm on; re-run with -y/--yes to release without asking\n' >&2
            exit 1
        fi
        printf 'Release dreidel %s -> %s: commit changelog, bump, tag %s, publish to crates.io, push? [y/N] ' \
            "$current_version" "$next_version" "$TAG"
        read -r answer
        case "$answer" in
            y | Y | yes | YES) ;;
            *)
                printf 'Aborted; nothing changed.\n'
                exit 1
                ;;
        esac
    fi

    # A rollback abandons everything after the starting commit, so refuse to start
    # with uncommitted work that it would throw away.
    if [[ -n "$(jj diff --summary)" ]]; then
        printf 'error: working copy has uncommitted changes; commit or discard them first\n' >&2
        exit 1
    fi
    start_commit=$(jj log --no-graph -r @- -T commit_id)

    # Regenerate CHANGELOG and commit it before the cargo-release version-bump
    # commit. Done here (not in a cargo-release pre-release-hook) so we can use
    # jj to commit rather than git add, keeping the workflow jj-native.
    git-cliff --tag "$TAG" --output CHANGELOG.md
    jj commit -m "chore: update changelog for $TAG"

    # Bump version in Cargo.toml, commit, publish, and create the git tag.
    # Confirmation already happened above, so don't let cargo release prompt.
    release_ok=true
    cargo release "$LEVEL" --execute --no-confirm || release_ok=false

    # Never push unless cargo release really produced the tag.
    if ! "$release_ok" || ! git rev-parse -q --verify "refs/tags/$TAG" >/dev/null; then
        # If the version reached crates.io, the release can't be undone: keep the
        # commits and finish by hand rather than orphaning a published version.
        if curl -sfA "dreidel-release-script" -o /dev/null \
            "https://crates.io/api/v1/crates/dreidel/$next_version"; then
            printf '\nerror: dreidel %s was published, but tagging/pushing did not complete.\n' "$next_version" >&2
            printf 'Finish by hand:\n' >&2
            printf '  git tag -a %s -m "Release %s" <release commit>   # if the tag is missing\n' "$TAG" "$TAG" >&2
            printf '  jj git fetch && jj bookmark set main -r @- && jj git push --bookmark main\n' >&2
            printf '  git push origin %s\n' "$TAG" >&2
            exit 1
        fi

        # Nothing was published: undo the local changelog/version commits and tag
        # so a plain re-run starts clean.
        printf '\nerror: cargo release failed; nothing was published or pushed. Rolling back...\n' >&2
        git tag -d "$TAG" >/dev/null 2>&1 || true
        jj abandon "${start_commit}..@" >/dev/null
        jj new "$start_commit" >/dev/null 2>&1 || true
        printf 'Rolled back to %s.\n' "${start_commit:0:12}" >&2
        printf 'If the error above was a crates.io authentication failure (403), run\n' >&2
        printf "'cargo login' with a fresh token, then re-run this script.\n" >&2
        exit 1
    fi

    printf '\nPushing %s to origin...\n' "$TAG"

    # Sync jj's view of the git state, advance the main bookmark, and push.
    jj git fetch
    jj bookmark set main -r @-
    jj git push --bookmark main

    # Push the git tag that cargo-release created (jj doesn't manage git tags
    # directly; use git in the co-located repo).
    # This tag push triggers the cargo-dist CI workflow, which builds the release
    # artifacts and creates the GitHub release automatically.
    git push origin "$TAG"

    printf '\nPushed %s — cargo-dist CI will build artifacts and create the GitHub release.\n' "$TAG"
fi
